generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LayoutStyle {
  LIST
  GRID
}

enum Role {
  USER
  ADMIN
}

enum WorkspaceRole {
  OWNER
  EDITOR
}

model User {
  id              String    @id @default(uuid())
  name            String?
  email           String    @unique
  emailVerified   DateTime?
  image           String?
  backgroundImage String?

  password String?

  username String? @unique

  bio String?

  seoTitle       String?
  seoDescription String?

  resumeDownloadCount Int         @default(0)
  themeType           String      @default("solid")
  themeColor          String      @default("slate")
  themeCustom         String?
  enableEmailCapture  Boolean     @default(false)
  layoutStyle         LayoutStyle @default(LIST)

  links           Link[]
  subscribers     Subscriber[]
  accounts        Account[]
  sessions        Session[]
  aliases         UserAlias[]
  mergeRequests   AccountMergeRequest[]
  usernameHistory UsernameHistory[]
  profileDraft    ProfileDraft?         @relation(fields: [profileDraftId], references: [id])
  profileVersions ProfileVersion[]
  previewTokens   ProfilePreviewToken[]
  isVerified      Boolean               @default(false)
  role            Role                  @default(USER)
  createdAt       DateTime              @default(now())

  theme String @default("default")

  customDomain     String?           @unique
  totpSecret       String?
  twoFactorEnabled Boolean           @default(false)
  recoveryCodes    String?
  profileDraftId   String?
  workspaceMembers WorkspaceMember[]

  @@index([username])
}

model UserAlias {
  id          String    @id @default(uuid())
  username    String    @unique
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id])
  userId      String?

  @@index([workspaceId])
}

model Link {
  id             String               @id @default(uuid())
  platform       String
  alias          String?
  label          String
  url            String
  position       Int                  @default(0)
  clicks         Int                  @default(0)
  isPublic       Boolean              @default(true)
  isGroup        Boolean              @default(false)
  parentId       String?
  pinCode        String?
  isSocialIcon   Boolean              @default(false)
  startDate      DateTime?
  endDate        DateTime?
  abTestVariant    String?
  abTestParentId   String?
  abTestParent     Link?    @relation("LinkAbTest", fields: [abTestParentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  abTestVariants   Link[]   @relation("LinkAbTest")
  workspaceId    String
  workspace      Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent         Link?                @relation("LinkGroup", fields: [parentId], references: [id], onDelete: SetNull)
  children       Link[]               @relation("LinkGroup")
  clickEvents    ClickEvent[]
  dailyAnalytics DailyLinkAnalytics[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  user           User?                @relation(fields: [userId], references: [id])
  userId         String?

  @@index([workspaceId])
  @@index([platform])
  @@index([parentId])
  @@index([abTestParentId])
}

model ClickEvent {
  id              String   @id @default(uuid())
  linkId          String
  link            Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  visitorKey      String?
  userAgent       String?
  referrer        String?
  country         String?
  deviceType      String?
  isBot           Boolean  @default(false)
  isUniqueVisitor Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([linkId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([linkId, visitorKey, createdAt])
  @@index([createdAt])
}

model DailyLinkAnalytics {
  id           String   @id @default(uuid())
  linkId       String
  link         Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  date         DateTime
  totalClicks  Int      @default(0)
  uniqueClicks Int      @default(0)
  botClicks    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([linkId, date])
  @@index([workspaceId, date])
  @@index([date])
}

model AccountMergeRequest {
  id               String    @id @default(uuid())
  codeHash         String    @unique
  targetUserId     String
  targetUser       User      @relation(fields: [targetUserId], references: [id], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  consumedAt       DateTime?
  consumedByUserId String?

  @@index([targetUserId, createdAt])
  @@index([expiresAt])
}

model AccountMergeEvent {
  id                  String   @id @default(uuid())
  sourceUserId        String
  targetUserId        String
  sourceEmail         String
  targetEmail         String
  sourceUsername      String?
  targetUsername      String?
  mergedLinks         Int      @default(0)
  mergedAccounts      Int      @default(0)
  transferredSessions Int      @default(0)
  conflictsJson       String?
  createdAt           DateTime @default(now())

  @@index([sourceUserId])
  @@index([targetUserId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UsernameHistory {
  id               String   @id @default(cuid())
  previousUsername String   @unique
  workspaceId      String
  createdAt        DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?
}

model ProfileDraft {
  id              String   @id @default(cuid())
  workspaceId     String   @unique
  name            String?
  username        String?
  bio             String?
  image           String?
  backgroundImage String?
  themeType       String?
  themeColor      String?
  themeCustom     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  users     User[]
}

model ProfileVersion {
  id              String   @id @default(cuid())
  workspaceId     String
  name            String?
  username        String?
  bio             String?
  image           String?
  backgroundImage String?
  themeType       String?
  themeColor      String?
  themeCustom     String?
  changeType      String // "publish" or "rollback"
  diffJson        String? // JSON stringified diff
  createdAt       DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?

  @@index([workspaceId, createdAt])
}

model ProfilePreviewToken {
  id          String    @id @default(cuid())
  workspaceId String
  tokenHash   String    @unique // SHA256 hash of the actual token
  expiresAt   DateTime
  createdAt   DateTime  @default(now())
  revokedAt   DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id])
  userId    String?

  @@index([workspaceId, expiresAt])
}

enum JobStatus {
  PENDING
  SCHEDULED
  PROCESSING
  COMPLETED
  FAILED
}

model Job {
  id         String    @id @default(cuid())
  type       String
  payload    Json
  status     JobStatus @default(PENDING)
  userId     String    @default("")
  scheduleAt DateTime?
  attempts   Int       @default(0)
  lastError  String?
  runAfter   DateTime? // next eligible run time
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status, runAfter])
  @@index([scheduleAt])
  @@index([userId])
}

model DeleteOtp {
  userId      String    @id
  otp         String?
  expiresAt   DateTime?
  attempts    Int       @default(0)
  sendCount   Int       @default(0)
  windowStart DateTime?

  @@index([windowStart])
  @@map("deleteOtp")
}

model InvalidatedSession {
  userId    String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("invalidatedSession")
}

model Subscriber {
  id          String    @id @default(uuid())
  email       String
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  user        User?     @relation(fields: [userId], references: [id])
  userId      String?

  @@unique([email, workspaceId])
  @@index([workspaceId])
}

enum WorkspaceRole {
  OWNER
  EDITOR
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  userId      String
  workspaceId String
  role        WorkspaceRole @default(EDITOR)
  createdAt   DateTime      @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Workspace {
  id              String  @id @default(uuid())
  name            String?
  username        String? @unique
  customDomain    String? @unique
  bio             String?
  seoTitle        String?
  seoDescription  String?
  image           String?
  backgroundImage String?

  themeType   String      @default("solid")
  themeColor  String      @default("slate")
  themeCustom String?
  theme       String      @default("default")
  layoutStyle LayoutStyle @default(LIST)

  enableEmailCapture  Boolean @default(false)
  resumeUrl           String?
  resumeDownloadCount Int     @default(0)

  members         WorkspaceMember[]
  links           Link[]
  clickEvents     ClickEvent[]
  dailyAnalytics  DailyLinkAnalytics[]
  aliases         UserAlias[]
  usernameHistory UsernameHistory[]
  profileDraft    ProfileDraft?
  profileVersions ProfileVersion[]
  previewTokens   ProfilePreviewToken[]

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  subscribers Subscriber[]

  @@index([username])
}
